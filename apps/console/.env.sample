# Auth service (login/refresh/logout, identity, OIDC continuation).
# For the OIDC login continuation to work, this origin must match the
# auth service's OIDC issuer, and the auth service's OIDC_LOGIN_URL must
# point to this console's /login page.
VITE_API_BASE_URL=https://auth.sb0rka.ru

# Platform API.
VITE_RESOURCE_API_BASE_URL=https://api.sb0rka.ru

# SQL executor proxy.
VITE_QUERY_RUNNER_BASE_URL=https://psql-executor.proxy.sb0rka.ru

# Optional: landing page the logo links to (defaults to "/").
# VITE_LANDING_URL=

# Optional: run the console against the built-in mock API (no backends).
# VITE_USE_MOCK_API=true
