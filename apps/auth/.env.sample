# Server configuration
SERVER_ADDR="localhost"
SERVER_PORT="8020"
SERVER_CORS_WHITELIST="http://localhost:3000"
SERVER_CORS_ALLOWED_DEFAULT_METHODS="GET,POST,PATCH,PUT,DELETE,OPTIONS"

# Database configuration
DATABASE_URI="postgres://postgres:postgres@host.docker.internal:5432/auth"
DATABASE_MAX_OPEN_CONNS="10"
DATABASE_CONN_MAX_LIFETIME_SEC="30"

# Logger configuration
LOG_LEVEL="info"
LOG_FORMAT="text"

# Access token private key configuration
# ACCESS_TOKEN_PRIVATE_KEY_FILE_PATH="access_token_private_key.pem"
ACCESS_TOKEN_PRIVATE_KEY="PRIVATE_KEY_BASE64"
ACCESS_SESSION_TTL_SEC="604800"
ACCESS_TOKEN_TTL_SEC="300"
ACCESS_TOKEN_ISSUER="auth.local"
ACCESS_TOKEN_AUDIENCE="api.local"
ACCESS_TOKEN_KID="ed25519-v1"
ACCESS_TOKEN_TYP="access+jwt"

# Refresh token cookie configuration (for local development)
REFRESH_TOKEN_COOKIE_NAME="refresh_token"
REFRESH_TOKEN_COOKIE_SECURE="false"
REFRESH_TOKEN_COOKIE_PATH="/"
REFRESH_TOKEN_COOKIE_DOMAIN="localhost"
REFRESH_TOKEN_COOKIE_HTTP_ONLY="false"
REFRESH_TOKEN_COOKIE_SAMESITE="0"

# # Refresh token cookie configuration
# REFRESH_TOKEN_COOKIE_NAME="__Host-refresh_token"
# REFRESH_TOKEN_COOKIE_SECURE="true"
# REFRESH_TOKEN_COOKIE_PATH="/"
# REFRESH_TOKEN_COOKIE_DOMAIN="localhost"
# REFRESH_TOKEN_COOKIE_HTTP_ONLY="true"
# REFRESH_TOKEN_COOKIE_SAMESITE="2"