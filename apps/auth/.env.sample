# Server configuration
SERVER_ADDR="0.0.0.0"
SERVER_PORT="8020"
SERVER_CORS_WHITELIST="http://localhost:4173,http://localhost:5173"
SERVER_CORS_ALLOWED_DEFAULT_METHODS="GET,POST,PATCH,PUT,DELETE,OPTIONS"

# Database configuration
DATABASE_URI="postgres://postgres:postgres@postgres:5432/platform"
DATABASE_MAX_OPEN_CONNS="10"
DATABASE_CONN_MAX_LIFETIME_SEC="30"

# Logger configuration
LOG_LEVEL="info"
LOG_FORMAT="text"

# Access token private key configuration
ACCESS_TOKEN_PRIVATE_KEY_FILE_PATH="/keys/access_token_private_key.pem"
# ACCESS_TOKEN_PRIVATE_KEY="PRIVATE_KEY_BASE64"
ACCESS_SESSION_TTL_SEC="604800"
# Dev: set issue TTL to 3600 and max TTL >=3600 on Auth and every resource server.
ACCESS_TOKEN_TTL_SEC="300"
MAX_ACCESS_TOKEN_TTL_SEC="600"
ACCESS_TOKEN_CLOCK_SKEW_SEC="30"
AUTH_BASE_URL="https://auth.sb0rka.internal"
ACCESS_TOKEN_KID="ed25519-v1"

# Refresh token cookie configuration (for local development)
REFRESH_TOKEN_COOKIE_NAME="refresh_token"
REFRESH_TOKEN_COOKIE_SECURE="false"
REFRESH_TOKEN_COOKIE_PATH="/"
REFRESH_TOKEN_COOKIE_DOMAIN=""
REFRESH_TOKEN_COOKIE_HTTP_ONLY="true"
REFRESH_TOKEN_COOKIE_SAMESITE="2"

# Production-shaped alternative when Domain must be set (__Host- forbids Domain;
# app default is __Host-refresh_token with empty Domain and SameSite=Lax).
# REFRESH_TOKEN_COOKIE_NAME="__Secure-refresh_token"
# REFRESH_TOKEN_COOKIE_SECURE="true"
# REFRESH_TOKEN_COOKIE_PATH="/"
# REFRESH_TOKEN_COOKIE_DOMAIN="auth.sb0rka.ru"
# REFRESH_TOKEN_COOKIE_HTTP_ONLY="true"
# REFRESH_TOKEN_COOKIE_SAMESITE="4"

# OIDC configuration
OIDC_LOGIN_URL="http://localhost:5173/login"

# Confidential platform clients. Each name is secret_env (or attestation_secret_env)
# in db/migrations/seed/011-initial_auth_clients.sql. Generate values with
# deploy/dev/gen_client_secrets.sh.
SB0RKA_SOM_WEB_CLIENT_SECRET=""
SB0RKA_IR_WEB_CLIENT_SECRET=""
SB0RKA_SOM_WORKLOAD_CLIENT_SECRET=""
SB0RKA_SOM_ATTESTATION_SECRET=""
SB0RKA_IR_GATEWAY_CLIENT_SECRET=""
OIDC_SIGNING_PRIVATE_KEY_FILE_PATH="/keys/oidc_signing_private_key.pem"
OIDC_SIGNING_KID="rsa-2026-01"
OIDC_PROVIDER_CRYPTO_KEY_FILE_PATH="/keys/oidc_provider_crypto_key"
OIDC_CODE_HMAC_KEY_FILE_PATH="/keys/oidc_code_hmac_key"

# Insecure HTTP issuer (for local development)
OIDC_ALLOW_INSECURE_HTTP_ISSUER="true"

API_BASE_URL="http://api:8080"

# Keep retired PUBLIC signing keys for at least max token TTL plus clock skew.
# ACCESS_TOKEN_PREVIOUS_JWKS_FILE_PATH="/keys/previous-public-jwks.json"
