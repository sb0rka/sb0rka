# Server configuration
SERVER_ADDR="localhost"
SERVER_PORT="8020"
SERVER_CORS_WHITELIST="http://localhost:4173"
SERVER_CORS_ALLOWED_DEFAULT_METHODS="GET,POST,PATCH,PUT,DELETE,OPTIONS"

# Database configuration
DATABASE_URI="postgres://postgres:postgres@host.docker.internal:5432/auth"
DATABASE_MAX_OPEN_CONNS="10"
DATABASE_CONN_MAX_LIFETIME_SEC="30"

# Logger configuration
LOG_LEVEL="info"
LOG_FORMAT="text"

# Access token private key configuration
# ACCESS_TOKEN_PRIVATE_KEY_FILE_PATH="access_token_private_key.pem"
ACCESS_TOKEN_PRIVATE_KEY="PRIVATE_KEY_BASE64"
ACCESS_SESSION_TTL_SEC="604800"
ACCESS_TOKEN_TTL_SEC="300"
ACCESS_TOKEN_ISSUER="auth.local"
ACCESS_TOKEN_AUDIENCE="api.local"
ACCESS_TOKEN_KID="ed25519-v1"
ACCESS_TOKEN_TYP="access+jwt"

# Refresh token cookie configuration (for local development)
REFRESH_TOKEN_COOKIE_NAME="refresh_token"
REFRESH_TOKEN_COOKIE_SECURE="false"
REFRESH_TOKEN_COOKIE_PATH="/"
REFRESH_TOKEN_COOKIE_DOMAIN=""
REFRESH_TOKEN_COOKIE_HTTP_ONLY="true"
REFRESH_TOKEN_COOKIE_SAMESITE="2"

# Production-shaped alternative when Domain must be set (__Host- forbids Domain;
# app default is __Host-refresh_token with empty Domain and SameSite=Lax).
# REFRESH_TOKEN_COOKIE_NAME="__Secure-refresh_token"
# REFRESH_TOKEN_COOKIE_SECURE="true"
# REFRESH_TOKEN_COOKIE_PATH="/"
# REFRESH_TOKEN_COOKIE_DOMAIN="auth.sb0rka.ru"
# REFRESH_TOKEN_COOKIE_HTTP_ONLY="true"
# REFRESH_TOKEN_COOKIE_SAMESITE="4"

# Optional OIDC provider
# OIDC is disabled only when every variable below is absent, partial config is rejected.
# OIDC_ISSUER="https://auth.sb0rka.ru"
# OIDC_LOGIN_URL="https://console.sb0rka.ru/login"
# OIDC_CLIENT_ID="example-client"
# OIDC_CLIENT_SECRET="at-least-32-random-bytes"
# OIDC_REDIRECT_URIS="https://client.example.com/oauth/callback"
# OIDC_SIGNING_PRIVATE_KEY_FILE_PATH="/run/secrets/oidc_signing_private_key.pem"
# OIDC_SIGNING_KID="rsa-2026-01"
# OIDC_PROVIDER_CRYPTO_KEY_FILE_PATH="/run/secrets/oidc_provider_crypto_key"
# OIDC_CODE_HMAC_KEY_FILE_PATH="/run/secrets/oidc_code_hmac_key"
# For loopback/private-network development only:
# OIDC_ALLOW_INSECURE_HTTP_ISSUER="true"
