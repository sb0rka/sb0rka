# Ollama (OpenAI-compatible API). Use /v1 — nl2sql calls /v1/chat/completions.
OPENAI_BASE_URL=http://192.168.0.159:11434/v1
OPENAI_MODEL=llama3.2

# Optional for Ollama; required for api.openai.com and many hosted providers.
# OPENAI_API_KEY=

HTTP_LISTEN_ADDR=:8083

# Max wait per LLM HTTP call (Go duration). Two calls run for /generate (SQL + explanation).
LLM_TIMEOUT=5m
